# Copy this file to `.env` (git-ignored) and fill in the first three values.

# --- LLM provider: any OpenAI-compatible endpoint --------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Prices in USD per million tokens. Used only for the cost estimate shown in
# the UI and logs — set them to your provider's rates for your model.
# LLM_PRICE_INPUT_PER_M=0.10
# LLM_PRICE_OUTPUT_PER_M=0.50

# Resilience (defaults shown):
# LLM_TIMEOUT_S=60
# LLM_MAX_RETRIES=2

# --- Retrieval --------------------------------------------------------------
# dense | hybrid | hybrid_rerank (default: hybrid).
# hybrid_rerank downloads bge-reranker-v2-m3 (~1.1 GB) on first use.
# RETRIEVAL_MODE=hybrid

# Rewrite follow-up questions into standalone queries (default: true).
# QUERY_REWRITE=true

# --- Agent ------------------------------------------------------------------
# How mode="auto" picks a pipeline: escalate | classify (default: escalate).
# AUTO_STRATEGY=escalate
# AGENT_MAX_ITERATIONS=6
# AGENT_TOKEN_BUDGET=120000
# AGENT_COMPACT_AT=16000

# --- API --------------------------------------------------------------------
# Directories /ingest may index (comma-separated):
# INGEST_DIRS=corpus,examples,data/uploads
# MAX_UPLOAD_MB=5

# Set these before exposing the server beyond localhost:
# API_KEY=                    # clients must send X-API-Key (empty = auth off)
# RATE_LIMIT_PER_MINUTE=30    # per-client limit on /ask* (0 = off)
# READ_ONLY=false             # true disables ingest, upload and delete
# DAILY_REQUEST_BUDGET=0      # cap on /ask* requests per UTC day (0 = off)
# TRUST_PROXY=false           # true only behind a proxy that sets X-Forwarded-For

# --- Local model cache ------------------------------------------------------
# Redirect the Hugging Face cache, e.g. when the system drive is small:
# HF_HOME=E:\hf_cache
