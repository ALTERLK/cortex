# Copy this file to `.env` (which is git-ignored) and fill in real values.
# Get an API key from your chosen provider (DeepSeek, 4SAPI, OpenRouter, etc.)
LLM_API_KEY=

# Required: the base URL of your provider's OpenAI-compatible endpoint.
LLM_BASE_URL=https://api.deepseek.com

# Optional override (default shown):
# LLM_MODEL=deepseek-chat

# LLM resilience (defaults shown):
# LLM_TIMEOUT_S=60
# LLM_MAX_RETRIES=2

# Retrieval strategy: dense | hybrid | hybrid_rerank (default: hybrid).
# hybrid_rerank downloads bge-reranker-v2-m3 (~1.1 GB) on first use.
# RETRIEVAL_MODE=hybrid

# Rewrite history-dependent follow-ups into standalone queries (default: true).
# QUERY_REWRITE=true

# API protection — set both before exposing the server publicly:
# API_KEY=                      # clients must send X-API-Key (empty = auth off)
# RATE_LIMIT_PER_MINUTE=30      # per-IP limit on /ask* (0 = off)

# Directories /ingest is allowed to index (comma-separated):
# INGEST_DIRS=docs,corpus

# On Windows: redirect HuggingFace model cache if C: drive is small
# HF_HOME=E:\hf_cache
